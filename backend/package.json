{
  "name": "callpilot-backend",
  "version": "1.0.0",
  "description": "CallPilot Cloudflare Workers Backend with D1 & Sarvam AI Integration",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute callpilot-db --local --file=./migrations/0001_initial.sql",
    "db:seed": "wrangler d1 execute callpilot-db --local --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test_e2e.mjs"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
