# Optional (plain vars): free-trial minutes for a first signup (default 30) and
# the page Razorpay redirects to after payment.
TRIAL_MINUTES=
BILLING_RETURN_URL=
# Optional (plain vars): GST added to every catalogue price (fraction, default 0.18).
GST_RATE=
# Optional (plain vars): our cost per call minute in INR for GET /admin/economics
