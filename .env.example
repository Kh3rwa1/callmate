# CALLMATE AI — backend environment
#
# Copy this file to .env and fill in real values. Never commit the filled-in
# file: it holds the credentials that place real phone calls.
#
# These variables belong to the BACKEND only. They are read by the Supabase Edge
# Functions (supabase/functions/api), never by the web app. The app talks to our
# backend and the backend talks to Sarvam, so no Sarvam credential is ever
# shipped to a browser.

# Which voice provider mode the backend runs in:
#   mock   = calls are simulated locally, the app is fully usable with no account
#   sarvam = real calls are placed through the Sarvam Voice Agents API
VOICE_MODE=mock

# --- Sarvam credentials -----------------------------------------------------
# Create and manage the key in the Sarvam dashboard under Settings -> API Key.
# Sent to Sarvam as the X-API-Key header.
SARVAM_API_KEY=

# Service base URLs (defaults shown; override only if Sarvam moves them).
SARVAM_OUTBOUNDS_BASE_URL=https://apps.sarvam.ai/api/outbounds
SARVAM_SCHEDULING_BASE_URL=https://apps.sarvam.ai/api/scheduling
SARVAM_DEPLOYMENTS_BASE_URL=https://apps.sarvam.ai/api/app-authoring

# The agent used when an organization has not set its own.
# Leave empty in production: each organization stores its own deployment id.
SARVAM_DEFAULT_DEPLOYMENT_ID=

# Shared secret used to verify incoming webhooks from Sarvam.
# Requests must present this as `Authorization: Bearer <secret>` or as an
# HMAC-SHA256 signature of the raw body in `X-Sarvam-Signature`.
# While this is empty, incoming webhooks are recorded but NOT applied.
SARVAM_WEBHOOK_SECRET=

# Public URL of this backend's webhook endpoint, e.g.
#   https://<project-ref>.supabase.co/functions/v1/sarvam-webhook
SARVAM_WEBHOOK_URL=
